# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Admin Authentication ─────────────────────────────────
# JSON array of bcrypt-hashed PINs with admin names.
# Generate hashes: node -e "const b=require('bcryptjs');b.hash('0000',10).then(h=>console.log(h))"
# Format: [{"hash":"$2a$10$...","name":"Admin"},{"hash":"$2a$10$...","name":"Humaan"}]
ADMIN_PIN_HASHES=[{"hash":"GENERATE_WITH_BCRYPT","name":"Admin"},{"hash":"GENERATE_WITH_BCRYPT","name":"Humaan"}]

# ─── External Services ───────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_WHATSAPP_NUMBER=971501234567
NEXT_PUBLIC_FB_PIXEL_ID=your-pixel-id
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Internal API Wiring ─────────────────────────────────
# Used by /api/team/items to call /api/items/[id]/generate-listing internally
NEXT_PUBLIC_BASE_URL=https://bufaisal.ae
# Bearer auth for /api/items/[id]/generate-listing and /api/cron/cleanup-stuck-processing
INTERNAL_API_SECRET=your-internal-api-secret

# ─── Session Security ───────────────────────────────────
# Optional: dedicated secret for admin session tokens (falls back to SUPABASE_SERVICE_ROLE_KEY)
# ADMIN_SESSION_SECRET=your-random-secret-here

# ─── Google Sheets Export ────────────────────────────────
# GOOGLE_SHEETS_ID=your-sheet-id
# GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
